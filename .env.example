# Template for local config. Copy to .env and fill in real values:
#   cp .env.example .env
# .env is gitignored; never put real secrets in this committed example file.
# Real environment variables set in the shell take precedence over .env.

# --- Core ---
# SQLAlchemy database URL. Local default is SQLite; use Postgres/Supabase in prod:
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_URL=sqlite:///./headway.db

# Secret used to sign JWTs. MUST be a long random string in production.
# The app refuses to boot when ENVIRONMENT=production and this is left as the default.
JWT_SECRET_KEY=change-me-in-production

# Access-token lifetime in minutes.
JWT_EXPIRE_MINUTES=60

# --- OAuth/OIDC login ---
# Optional external login. Provider names become /auth/oauth/{provider}/login.
# Example Google setup:
# OAUTH_GOOGLE_CLIENT_ID=replace-me
# OAUTH_GOOGLE_CLIENT_SECRET=replace-me
# Google endpoints are built in. Generic providers use the same pattern with
# their provider name and must also set endpoint URLs, for example:
# OAUTH_EXAMPLE_CLIENT_ID=replace-me
# OAUTH_EXAMPLE_CLIENT_SECRET=replace-me
# OAUTH_EXAMPLE_AUTHORIZATION_URL=https://issuer.example/oauth/authorize
# OAUTH_EXAMPLE_TOKEN_URL=https://issuer.example/oauth/token
# OAUTH_EXAMPLE_USERINFO_URL=https://issuer.example/oauth/userinfo
#
# Optional overrides:
# OAUTH_GOOGLE_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
# OAUTH_GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# OAUTH_GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
# OAUTH_GOOGLE_SCOPES=openid email profile
# Require OIDC userinfo email_verified=true before linking/creating users.
# OAUTH_GOOGLE_REQUIRE_VERIFIED_EMAIL=true

# Create tables on startup. Handy locally; prefer migrations in production.
AUTO_CREATE_TABLES=true

# development | production
ENVIRONMENT=development

# --- Realtime notifications ---
# Run the in-process outbox dispatcher that pushes events to connected WebSocket
# sockets. Single-instance only: delivery is in-memory, so it must run inside the
# API process. Leave false if you don't need realtime push (REST polling still
# works via GET /notifications/me).
REALTIME_DISPATCH_ENABLED=false
# Max outbox events drained per poll, and the poll interval in seconds.
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_SECONDS=1.0
